{
  "name": "embeddable.com-boilerplate-repo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "npm": ">=9.0.0",
    "node": ">=20.18"
  },
  "scripts": {
    "ct": "tsconfig --noEmit",
    "test": "jest",
    "cube:playground": "docker compose -f ./src/cube-playground.yml up",
    "cube:playground:update": "docker pull cubejs/cube:latest",
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=4096' embeddable dev",
    "embeddable:build": "embeddable build",
    "embeddable:dev": "cross-env NODE_OPTIONS='--max-old-space-size=4096' embeddable dev",
    "embeddable:login": "embeddable login",
    "embeddable:push": "embeddable push",
    "embeddable:upgrade": "npx npm-check-updates -u \"/embeddable/\"",
    "embedding-preview": "node src/scripts/embedding-preview.cjs"
  },
  "dependencies": {
    "@embeddable.com/vanilla-components": "^1.3.3",
    "@stencil/core": "^4.23.0",
    "chart.js": "^4.4.9",
    "dotenv": "^17.2.3",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/runtime": "^7.28.4",
    "@cubejs-client/core": "^1.5.1",
    "@embeddable.com/core": "^2.13.6",
    "@embeddable.com/react": "^2.13.5",
    "@embeddable.com/sdk-core": "^4.3.1",
    "@embeddable.com/sdk-react": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "^18.2.0",
    "cross-env": "^7.0.3",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@9.14.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js"
    ]
  }
}
